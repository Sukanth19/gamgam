# copy to .env and fill in
GEMINI_API_KEY=

# embeddings: local (free, on your cpu, no limits) or gemini (free tier ~1000 texts/day)
EMBED_PROVIDER=local

# game data source: igdb (default) or rawg
GAME_SOURCE=igdb

# igdb: create a free app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# rawg (only if GAME_SOURCE=rawg): https://rawg.io/apidocs
RAWG_API_KEY=

# chat llm: ollama (default; local, needs `ollama pull qwen3:8b`) or gemini (uses GEMINI_API_KEY)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
